# Copiar como .env en la raíz del repositorio y ajustar los valores locales.
# No versionar .env: puede contener contraseñas y claves de cifrado.
PSICOAPP_NOMBRE_APLICACION=psicoapp
PSICOAPP_BD_URL=jdbc:mysql://localhost:3306/psicoapp?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
PSICOAPP_BD_USUARIO=root
PSICOAPP_BD_CLAVE=
PSICOAPP_SQL_INICIALIZACION=always
PSICOAPP_DOMINIOS_INSTITUCIONALES=universidad.edu.co
PSICOAPP_CORREO_ADMINISTRADOR=
PSICOAPP_CLAVE_ADMINISTRADOR=
PSICOAPP_JWT_CLAVE=
PSICOAPP_JWT_DURACION_SEGUNDOS=900
# Cambiar a true en producción para impedir el arranque sin una clave persistente.
PSICOAPP_JWT_CLAVE_REQUERIDA=false
# Orígenes web exactos separados por comas. Vacío porque el desarrollo usa el proxy de Angular.
PSICOAPP_CORS_ORIGENES=
PSICOAPP_PARTICIPACION_CIERRE_AUTOMATICO=true
PSICOAPP_PARTICIPACION_INTERVALO_CIERRE_MS=60000
PSICOAPP_SESIONES_INTERVALO_CIERRE_MS=60000
# Debe ser una clave AES-256 codificada en Base64. Generar una para cada entorno.
PSICOAPP_NOTIFICACIONES_CLAVE_CIFRADO=
PSICOAPP_NOTIFICACIONES_URL_ACCESO=http://localhost:3000/ingreso
PSICOAPP_NOTIFICACIONES_REMITENTE=
PSICOAPP_GMAIL_ID_CLIENTE=
PSICOAPP_GMAIL_SECRETO_CLIENTE=
PSICOAPP_GMAIL_TOKEN_RENOVACION=
PSICOAPP_NOTIFICACIONES_DESPACHO=false
PSICOAPP_NOTIFICACIONES_INTERVALO_MS=30000
# Habilita la generación de avisos internos para docentes. false conserva el historial existente.
PSICOAPP_NOTIFICACIONES_AVISOS_DOCENTE=true
# Horas antes del inicio durante las que se crea el recordatorio. Rango permitido: 1 a 168.
PSICOAPP_NOTIFICACIONES_RECORDATORIO_HORAS=24
# Frecuencia, en milisegundos, para revisar sesiones, evaluaciones y reportes docentes.
PSICOAPP_NOTIFICACIONES_AVISOS_DOCENTE_INTERVALO_MS=60000
# Espera, en milisegundos, desde el arranque hasta la primera revisión de avisos docentes.
PSICOAPP_NOTIFICACIONES_AVISOS_DOCENTE_DEMORA_INICIAL_MS=1000
# Valores locales usados únicamente por compose.yaml.
# Sustituirlos en despliegues compartidos o de producción.
PSICOAPP_DOCKER_BD_USUARIO=psicoapp
PSICOAPP_DOCKER_BD_CLAVE=psicoapp_local
PSICOAPP_DOCKER_MYSQL_ROOT_CLAVE=psicoapp_root_local
PSICOAPP_BACKEND_PUERTO=8080
